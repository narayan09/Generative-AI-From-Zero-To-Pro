Window Function Syntax
    FUNCTION_NAME() OVER(
        PARTITION BY column
        ORDER BY column
    )
select emp_name,salary,row_number() over (order by salary desc) as rank_num from employees

SELECT 
emp_name,
salary,
ROW_NUMBER() OVER(ORDER BY salary DESC) as row_num,
RANK() OVER(ORDER BY salary DESC) as rank_num,
DENSE_RANK() OVER(ORDER BY salary DESC) as dense_rank
FROM employees;

